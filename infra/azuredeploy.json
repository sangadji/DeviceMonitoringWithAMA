{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "samplingSeconds": { "type": "int", "defaultValue": 10, "minValue": 1, "maxValue": 2147483647 }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "law-contoso-device-monitoring-idc",
      "location": "indonesiacentral",
      "tags": { "project": "ContosoDeviceMonitoring" },
      "properties": {
        "sku": { "name": "PerGB2018" },
        "retentionInDays": 30,
        "workspaceCapping": { "dailyQuotaGb": 1 },
        "features": { "enableLogAccessUsingOnlyResourcePermissions": false }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "dcr-contoso-windows-performance",
      "location": "indonesiacentral",
      "kind": "Windows",
      "dependsOn": ["[resourceId('Microsoft.OperationalInsights/workspaces', 'law-contoso-device-monitoring-idc')]"],
      "tags": { "project": "ContosoDeviceMonitoring" },
      "properties": {
        "dataSources": {
          "performanceCounters": [{
            "name": "windowsPerformance",
            "streams": ["Microsoft-Perf"],
            "samplingFrequencyInSeconds": "[parameters('samplingSeconds')]",
            "counterSpecifiers": [
              "\\Processor(_Total)\\% Processor Time",
              "\\Memory\\Available MBytes",
              "\\Memory\\% Committed Bytes In Use",
              "\\LogicalDisk(*)\\% Free Space",
              "\\LogicalDisk(*)\\Free Megabytes",
              "\\PhysicalDisk(*)\\% Idle Time",
              "\\PhysicalDisk(*)\\Disk Read Bytes/sec",
              "\\PhysicalDisk(*)\\Disk Write Bytes/sec",
              "\\PhysicalDisk(*)\\Avg. Disk sec/Read",
              "\\PhysicalDisk(*)\\Avg. Disk sec/Write",
              "\\PhysicalDisk(*)\\Current Disk Queue Length",
              "\\Process(*)\\ID Process",
              "\\Process(*)\\Elapsed Time",
              "\\Process(*)\\% Processor Time",
              "\\Process(*)\\Working Set - Private",
              "\\Process(*)\\Private Bytes",
              "\\Process(*)\\IO Read Bytes/sec",
              "\\Process(*)\\IO Write Bytes/sec"
            ]
          }]
        },
        "destinations": {
          "logAnalytics": [{
            "name": "workspace",
            "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', 'law-contoso-device-monitoring-idc')]"
          }]
        },
        "dataFlows": [{ "streams": ["Microsoft-Perf"], "destinations": ["workspace"] }]
      }
    }
  ]
}